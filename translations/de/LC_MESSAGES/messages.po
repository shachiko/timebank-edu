#: app.py:328
msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "Bitte melden Sie sich an, um fortzufahren."

#: app.py:342
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "Bitte melden Sie sich mit einem Administratorkonto an."

#: app.py:357
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "Bitte melden Sie sich mit einem Super-Administrator-Konto an."

#: app.py:373
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr "Bitte melden Sie sich mit Lehrer- oder Administratorrechten an."

#: app.py:2191
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "Bitte füllen Sie alle Pflichtfelder (*) aus."

#: app.py:2195
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "Das Passwort muss mindestens 6 Zeichen lang sein."

#: app.py:2199
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "Die Passwortbestätigung stimmt nicht überein."

#: app.py:2205
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "Die Schüler-ID existiert bereits im System. Bitte überprüfen!"

#: app.py:2222
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "Der Einladungscode existiert nicht. Bitte überprüfen!"

#: app.py:2225
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr ""
"Die mit diesem Einladungscode verknüpfte Schule ist derzeit pausiert oder"
" deaktiviert!"

#: app.py:2228
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "Dieser Einladungscode hat das Nutzungslimit erreicht!"

#: app.py:2245
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "Die ausgewählte Schule ist derzeit pausiert oder deaktiviert!"

#: app.py:2295
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr ""
"Herzlichen Glückwunsch! Ihr Konto wurde mit einem Einladungscode "
"aktiviert und Sie haben 2,0 Zeitguthaben erhalten!"

#: app.py:2297
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr ""
"Registrierung erfolgreich! Ihr Konto wartet auf die Genehmigung durch den"
" Schuladministrator."

#: app.py:2329
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "Ungültige Anmelde-ID oder falsches Passwort!"

#: app.py:2335
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr ""
"Ihr Konto wurde wegen eines Verstoßes gegen die Schulordnung gesperrt. "
"Bitte wenden Sie sich an die Schulleitung."

#: app.py:2355
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "Erfolgreich angemeldet! Willkommen, %(name)s."

#: app.py:2375
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "Sie haben sich erfolgreich abgemeldet."

#: app.py:2392
msgid "Tài khoản demo không được phép đổi mật khẩu!"
msgstr "Demo-Konten für die Jury"

#: app.py:2400
msgid "Vui lòng điền đầy đủ thông tin đổi mật khẩu!"
msgstr "Bitte füllen Sie alle Pflichtfelder (*) aus."

#: app.py:2404 app.py:2575
msgid "Mật khẩu mới và xác nhận mật khẩu không khớp!"
msgstr "Neues Passwort und Bestätigungspasswort stimmen nicht überein!"

#: app.py:2408 app.py:2579
msgid "Mật khẩu mới phải có tối thiểu 6 ký tự!"
msgstr "Das Passwort muss mindestens 6 Zeichen lang sein."

#: app.py:2416
msgid "Mật khẩu hiện tại không chính xác!"
msgstr "Ungültige Anmelde-ID oder falsches Passwort!"

#: app.py:2422
msgid "Đổi mật khẩu thành công! Hãy ghi nhớ mật khẩu mới của bạn."
msgstr "Passwort erfolgreich geändert! Merken Sie sich Ihr neues Passwort."

#: app.py:2503
msgid "Vui lòng nhập địa chỉ email của bạn!"
msgstr "Bitte geben Sie Ihre E-Mail-Adresse ein!"

#: app.py:2516
msgid ""
"Không tìm thấy tài khoản quản trị hoặc giáo viên với email này. Vui lòng "
"liên hệ Tổng Quản trị viên (mshuyenuka@gmail.com) để được hỗ trợ."
msgstr ""
"Mit dieser E-Mail wurde kein Administrator- oder Lehrerkonto gefunden. "
"Bitte wenden Sie sich für Unterstützung an den Generaladministrator "
"(mshuyenuka@gmail.com)."

#: app.py:2536
#, python-format
msgid ""
"Đã gửi liên kết đặt lại mật khẩu đến email %(email)s. Vui lòng kiểm tra "
"hộp thư (liên kết có hiệu lực trong 60 phút)."
msgstr ""
"Link zum Zurücksetzen des Passworts an %(email)s-E-Mail gesendet. Bitte "
"überprüfen Sie Ihren Posteingang (Link ist 60 Minuten gültig)."

#: app.py:2563
msgid ""
"Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn (chỉ dùng được 1 "
"lần trong 60 phút). Vui lòng gửi lại yêu cầu mới."
msgstr ""
"Der Link zum Zurücksetzen des Passworts ist ungültig oder abgelaufen "
"(kann nur alle 60 Minuten verwendet werden). Bitte senden Sie erneut eine"
" neue Anfrage."

#: app.py:2571
msgid "Vui lòng nhập đầy đủ mật khẩu mới và xác nhận mật khẩu!"
msgstr "Bitte geben Sie das neue Passwort ein und bestätigen Sie das Passwort!"

#: app.py:2587
msgid "Đặt lại mật khẩu thành công! Bạn có thể đăng nhập bằng mật khẩu mới."
msgstr ""
"Passwort-Reset erfolgreich! Sie können sich mit Ihrem neuen Passwort "
"anmelden."

#: app.py:3118 app.py:3153
msgid "Chức năng chỉ dành riêng cho Tổng Quản trị viên (Super Admin)!"
msgstr "muss überprüft werden Funktion nur für Super Admin reserviert!"

#: app.py:3165
msgid ""
"Vui lòng điền đầy đủ các thông tin bắt buộc (Mã đăng nhập, Họ tên, Trường"
" học, Mật khẩu)!"
msgstr "Bitte füllen Sie alle Pflichtfelder (*) aus."

#: app.py:3169
msgid "Vai trò không hợp lệ (chỉ được tạo Quản trị trường hoặc Giáo viên)!"
msgstr ""
"Ungültige Rolle (nur Schuladministrator oder Lehrer können erstellt "
"werden)!"

#: app.py:3175
msgid "ID trường học không hợp lệ!"
msgstr "Ungültiger Schulausweis!"

#: app.py:3182
#, python-format
msgid "Mã đăng nhập '%(ma)s' đã tồn tại trong hệ thống!"
msgstr "Die Schüler-ID existiert bereits im System. Bitte überprüfen!"

#: app.py:3195
#, python-format
msgid ""
"Đã tạo thành công tài khoản '%(ho_ten)s' (%(vai_tro)s) gắn với trường học"
" ID %(tid)s!"
msgstr ""
"Das mit der Schul-ID %(tid)s verknüpfte Konto „%(ho_ten)s“ (%(vai_tro)s) "
"wurde erfolgreich erstellt!"

#: app.py:3210
msgid "Bạn không có quyền khôi phục dữ liệu Trường Demo!"
msgstr ""
"Sie haben keine Berechtigung zum Wiederherstellen der Daten der Demo-"
"Schule!"

#: app.py:3215
msgid "Đã khôi phục toàn bộ dữ liệu Trường Demo về trạng thái ban đầu thành công!"
msgstr ""
"Alle Demofelddaten wurden erfolgreich in ihren ursprünglichen Zustand "
"zurückversetzt!"

#: app.py:3398
msgid "Quản trị trường chỉ có quyền nhập danh sách cho trường của mình!"
msgstr ""
"festgelegt werden Schulleitungen haben nur das Recht, Listen für ihre "
"Schulen einzutragen!"

#: app.py:3410
msgid "Vui lòng chọn file Excel (.xlsx) hoặc CSV (.csv) để nhập danh sách!"
msgstr ""
"Bitte wählen Sie eine Excel-Datei (.xlsx) oder eine CSV-Datei (.csv) aus,"
" um die Liste zu importieren!"

#: app.py:3422
#, python-format
msgid "Lỗi khi đọc file Excel: %(err)s"
msgstr "Fehler beim Lesen der Excel-Datei: %(err)s"

#: app.py:3435
msgid "Không thể giải mã file CSV. Vui lòng lưu file với định dạng UTF-8!"
msgstr ""
"CSV-Datei kann nicht dekodiert werden. Bitte speichern Sie die Datei im "
"UTF-8-Format!"

#: app.py:3440
#, python-format
msgid "Lỗi khi đọc file CSV: %(err)s"
msgstr "Fehler beim Lesen der CSV-Datei: %(err)s"

#: app.py:3443
msgid "Định dạng file không được hỗ trợ. Vui lòng tải lên file .xlsx hoặc .csv!"
msgstr ""
"Dateiformat wird nicht unterstützt. Bitte laden Sie .xlsx- oder .csv-"
"Dateien hoch!"

#: app.py:3447
msgid "File tải lên không có dữ liệu để nhập!"
msgstr "Die hochgeladene Datei enthält keine zu importierenden Daten!"

#: app.py:3470
msgid ""
"File thiếu cột bắt buộc 'họ_tên' hoặc 'vai_trò'. Vui lòng tải file mẫu để"
" kiểm tra đúng cấu trúc!"
msgstr ""
"In der Datei fehlt die erforderliche Spalte „full_name“ oder „role“. "
"Bitte laden Sie die Beispieldatei herunter, um den korrekten Aufbau zu "
"überprüfen!"

#: app.py:3640
#, python-format
msgid ""
"Nhập danh sách thành công! Đã tạo %(count)s tài khoản cho trường "
"'%(school)s'. Vui lòng tải file Excel kết quả để phát thông tin đăng nhập"
" cho từng người."
msgstr ""
"Liste erfolgreich importieren! Konto %(count)s für Feld „%(school)s“ "
"erstellt. Bitte laden Sie die resultierende Excel-Datei herunter, um die "
"Anmeldeinformationen an jede Person zu verteilen."

#: app.py:3642
#, python-format
msgid ""
"Đã tạo thành công %(sc)s tài khoản; %(ec)s dòng bị lỗi/bỏ qua. Xem bảng "
"tổng kết chi tiết bên dưới."
msgstr ""
"%(sc)s-Konto erfolgreich erstellt; %(ec)s-Zeilenfehler/Übersprung. Siehe "
"detaillierte Übersichtstabelle unten."

#: app.py:3644
#, python-format
msgid ""
"Không có tài khoản nào được tạo. Toàn bộ %(ec)s dòng trong danh sách đều "
"có lỗi."
msgstr ""
"Es wurden keine Konten erstellt. Alle %(ec)s-Zeilen in der Liste weisen "
"Fehler auf."

#: app.py:3658
msgid ""
"Chưa có kết quả nhập tài khoản nào trong phiên làm việc hiện tại để tải "
"về!"
msgstr ""
"In der aktuellen Sitzung sind keine Kontoeintragsergebnisse zum "
"Herunterladen verfügbar!"

#: app.py:3866
#, python-format
msgid "Đã sinh thành công %(count)s mã mời dạng TBEDU-XXXX-XXXX!"
msgstr "%(count)s-Einladungscode TBEDU-XXXX-XXXX erfolgreich generiert!"

#: app.py:3882 app.py:3907 app.py:3976
msgid "Không tìm thấy người dùng."
msgstr "Benutzer nicht gefunden."

#: app.py:3886
msgid "Bạn chỉ có quyền phê duyệt học sinh thuộc trường của mình!"
msgstr "Sie haben nur das Recht, Schüler Ihrer Schule zu genehmigen!"

#: app.py:3891
#, python-format
msgid "Đã phê duyệt tài khoản %(name)s (%(code)s) thành công!"
msgstr "%(name)s (%(code)s)-Konto erfolgreich genehmigt!"

#: app.py:3911
msgid "Bạn chỉ có quyền thao tác trên học sinh thuộc trường của mình!"
msgstr "Sie haben nur das Recht, Schüler Ihrer Schule zu operieren!"

#: app.py:3916
#, python-format
msgid "Đã từ chối đăng ký của học sinh %(name)s."
msgstr "Die Registrierung des %(name)s-Studenten wurde abgelehnt."

#: app.py:3945
#, python-format
msgid "Đã phê duyệt %(count)s học sinh được chọn thành công!"
msgstr "Genehmigt %(count)s erfolgreich ausgewählte Studenten!"

#: app.py:3956
#, python-format
msgid "Đã duyệt toàn bộ %(count)s học sinh trong hàng chờ thành công!"
msgstr ""
"Alle %(count)s-Studenten in der Warteschlange wurden erfolgreich "
"genehmigt!"

#: app.py:3980
msgid "Bạn chỉ có quyền khóa tài khoản thuộc trường của mình!"
msgstr "Sie haben nur das Recht, das Konto Ihrer Schule zu sperren!"

#: app.py:3985
#, python-format
msgid ""
"Đã xác nhận KHÓA VĨNH VIỄN tài khoản của học sinh %(name)s (%(code)s) "
"theo quy chế xử lý vi phạm."
msgstr ""
"Es wurde bestätigt, dass das Schülerkonto von %(name)s (%(code)s) gemäß "
"den Vorschriften zum Umgang mit Verstößen dauerhaft gesperrt wird."

#: app.py:4000
msgid "Đã xử lý / hủy đề xuất kỷ luật."
msgstr "Disziplinarempfehlung bearbeitet/aufgehoben."

#: app.py:4014
msgid ""
"Trường Demo (ID 99) là dữ liệu mẫu của hệ thống, không được phép chỉnh "
"sửa logo!"
msgstr ""
"Demofeld (ID 99) sind Systembeispieldaten, Logobearbeitung ist nicht "
"erlaubt!"

#: app.py:4018
msgid "Bạn không có quyền cập nhật logo cho trường này."
msgstr "Sie sind nicht berechtigt, das Logo für dieses Feld zu aktualisieren."

#: app.py:4034
msgid "Đã cập nhật logo trường thành công!"
msgstr "Schullogo erfolgreich aktualisiert!"

#: app.py:4036
msgid "Vui lòng chọn file ảnh hợp lệ (PNG, JPG, WEBP)."
msgstr "Bitte wählen Sie eine gültige Bilddatei (PNG, JPG, WEBP) aus."

#: app.py:4056 app.py:4142
msgid "Tên trường học không được để trống!"
msgstr "Der Schulname darf nicht leer bleiben!"

#: app.py:4076
#, python-format
msgid "Trường học '%(name)s' đã tồn tại trong hệ thống!"
msgstr "Die Schüler-ID existiert bereits im System. Bitte überprüfen!"

#: app.py:4115
#, python-format
msgid "Đã thêm trường học mới '%(name)s' (Mã trường ID #%(id)s) thành công!"
msgstr "Neue Schule „%(name)s“ (Schul-ID #%(id)s) erfolgreich hinzugefügt!"

#: app.py:4127
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép chỉnh sửa"
" hoặc xóa!"
msgstr ""
"Demofeld (ID 99) ist ein Systembeispielfeld, eine Bearbeitung oder "
"Löschung ist nicht erlaubt!"

#: app.py:4135
msgid "Không tìm thấy trường học cần sửa!"
msgstr "Es wurden keine Schulen gefunden, die eine Reparatur benötigen!"

#: app.py:4157
#, python-format
msgid "Tên trường '%(name)s' trùng với một trường học khác đã có!"
msgstr ""
"Der Feldname „%(name)s“ stimmt mit einer anderen vorhandenen Schule "
"überein!"

#: app.py:4179
#, python-format
msgid "Đã cập nhật thông tin trường '%(name)s' thành công!"
msgstr "Feldinformationen „%(name)s“ erfolgreich aktualisiert!"

#: app.py:4193
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép vô hiệu "
"hóa!"
msgstr ""
"Das Demofeld (ID 99) ist ein Systembeispielfeld und kann nicht "
"deaktiviert werden!"

#: app.py:4201
msgid "Không tìm thấy trường học!"
msgstr "Schulübergreifendes System"

#: app.py:4242
msgid "Vui lòng nhập tên chương trình cộng đồng."
msgstr "Bitte geben Sie den Namen des Community-Programms ein."

#: app.py:4298 app.py:4368
msgid "Chương trình cộng đồng không tồn tại."
msgstr "Community-Programm existiert nicht."

#: app.py:4303
msgid "Bạn không có quyền chỉnh sửa chương trình của trường khác."
msgstr ""
"Sie sind nicht berechtigt, das Programm einer anderen Schule zu "
"bearbeiten."

#: app.py:4314
msgid "Tên chương trình không được để trống."
msgstr "Der Programmname darf nicht leer sein."

#: app.py:4373
msgid "Bạn không có quyền xóa chương trình của trường khác."
msgstr "Sie haben nicht das Recht, das Programm einer anderen Schule zu löschen."

#: app.py:4384 app.py:4389
msgid "tieu_de"
msgstr "tieu_de"

#: app.py:4569
msgid "Hành động không hợp lệ."
msgstr "Ungültige Aktion."

#: app.py:4578
#, python-format
msgid "Đã %(action)s kỹ năng #%(id)s thành công."
msgstr "Erfolgreicher %(action)s-Skill #%(id)s."

#: app.py:4602
msgid "Kỹ năng không tồn tại!"
msgstr "Fähigkeiten sind nicht vorhanden!"

#: app.py:4606
msgid "Bạn chỉ có thể đăng kỹ năng của chính mình lên Cộng đồng liên trường!"
msgstr ""
"Sie können nur Ihre eigenen Fähigkeiten in der Interschool-Community "
"veröffentlichen!"

#: app.py:4614
#, python-format
msgid "Bạn cần %(rem)s giờ dạy nữa để mở khóa Cộng đồng liên trường!"
msgstr ""
"Sie benötigen %(rem)s mehr Unterrichtsstunden, um die Interschool-"
"Community freizuschalten!"

#: app.py:4625
msgid ""
"Đã gửi yêu cầu đăng kỹ năng lên Cộng đồng liên trường. Vui lòng chờ Ban "
"quản trị duyệt!"
msgstr ""
"Habe eine Anfrage zum Posten des Skills in der Interschool-Community "
"eingereicht. Bitte warten Sie auf die Genehmigung des Admin-Boards!"

#: app.py:4648 app.py:4679
msgid "Không tìm thấy kỹ năng!"
msgstr "Kompetenzkurse entdecken"

#: app.py:4664
#, python-format
msgid ""
"Đã duyệt kỹ năng '%(title)s' (%(school)s) lên Cộng đồng liên trường thành"
" công!"
msgstr ""
"Der Skill „%(title)s“ (%(school)s) wurde erfolgreich für die "
"schulübergreifende Community zugelassen!"

#: app.py:4693
#, python-format
msgid "Đã từ chối đưa kỹ năng '%(title)s' lên Cộng đồng liên trường."
msgstr ""
"Es wurde abgelehnt, den Skill „%(title)s“ an die Interschool-Community zu"
" senden."

#: app.py:4714
msgid "Vui lòng đăng nhập để truy cập Cộng đồng liên trường."
msgstr "Bitte melden Sie sich an, um fortzufahren."

#: app.py:4926
msgid ""
"Tài khoản của bạn đang trong hàng chờ duyệt bởi Quản trị viên nhà trường."
" Bạn chưa thể đăng kỹ năng cho đến khi tài khoản được kích hoạt."
msgstr ""
"Registrierung erfolgreich! Ihr Konto wartet auf die Genehmigung durch den"
" Schuladministrator."

#: app.py:4935
msgid "Vui lòng điền đầy đủ lĩnh vực, tiêu đề và mô tả kỹ năng."

#: app.py:324
msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "Bitte melden Sie sich an, um fortzufahren."

#: app.py:338
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "Bitte melden Sie sich mit einem Administratorkonto an."

#: app.py:353
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "Bitte melden Sie sich mit einem Super-Administrator-Konto an."

#: app.py:369
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr "Bitte melden Sie sich mit Lehrer- oder Administratorrechten an."

#: app.py:2052
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "Bitte füllen Sie alle Pflichtfelder (*) aus."

#: app.py:2056
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "Das Passwort muss mindestens 6 Zeichen lang sein."

#: app.py:2060
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "Die Passwortbestätigung stimmt nicht überein."

#: app.py:2066
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "Die Schüler-ID existiert bereits im System. Bitte überprüfen!"

#: app.py:2083
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "Der Einladungscode existiert nicht. Bitte überprüfen!"

#: app.py:2086
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr ""
"Die mit diesem Einladungscode verknüpfte Schule ist derzeit pausiert oder"
" deaktiviert!"

#: app.py:2089
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "Dieser Einladungscode hat das Nutzungslimit erreicht!"

#: app.py:2106
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "Die ausgewählte Schule ist derzeit pausiert oder deaktiviert!"

#: app.py:2156
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr ""
"Herzlichen Glückwunsch! Ihr Konto wurde mit einem Einladungscode "
"aktiviert und Sie haben 2,0 Zeitguthaben erhalten!"

#: app.py:2158
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr ""
"Registrierung erfolgreich! Ihr Konto wartet auf die Genehmigung durch den"
" Schuladministrator."

#: app.py:2190
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "Ungültige Anmelde-ID oder falsches Passwort!"

#: app.py:2196
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr ""
"Ihr Konto wurde wegen eines Verstoßes gegen die Schulordnung gesperrt. "
"Bitte wenden Sie sich an die Schulleitung."

#: app.py:2216
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "Erfolgreich angemeldet! Willkommen, %(name)s."

#: app.py:2236
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "Sie haben sich erfolgreich abgemeldet."


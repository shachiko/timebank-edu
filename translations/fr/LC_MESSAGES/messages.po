#: app.py:328
msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "Veuillez vous connecter pour continuer."

#: app.py:342
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "Veuillez vous connecter avec un compte Administrateur."

#: app.py:357
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "Veuillez vous connecter avec un compte Super Administrateur."

#: app.py:373
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr ""
"Veuillez vous connecter avec les privilèges d'Enseignant ou "
"d'Administrateur."

#: app.py:2191
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "Veuillez renseigner tous les champs obligatoires (*)."

#: app.py:2195
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "Le mot de passe doit comporter au moins 6 caractères."

#: app.py:2199
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "La confirmation du mot de passe ne correspond pas."

#: app.py:2205
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "L'identifiant étudiant existe déjà dans le système. Veuillez vérifier !"

#: app.py:2222
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "Le code d'invitation n'existe pas. Veuillez vérifier !"

#: app.py:2225
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr ""
"L'école associée à ce code d'invitation est temporairement suspendue ou "
"désactivée !"

#: app.py:2228
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "Ce code d'invitation a atteint sa limite d'utilisation !"

#: app.py:2245
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "L'école sélectionnée est actuellement suspendue ou désactivée !"

#: app.py:2295
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr ""
"Félicitations ! Votre compte est activé avec un code d'invitation et 2,0 "
"crédits de temps vous sont accordés !"

#: app.py:2297
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr ""
"Inscription réussie ! Votre compte est en attente d'approbation par les "
"administrateurs scolaires."

#: app.py:2329
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "Identifiant ou mot de passe incorrect !"

#: app.py:2335
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr ""
"Votre compte a été verrouillé pour non-respect du règlement scolaire. "
"Veuillez contacter l'administration de l'école."

#: app.py:2355
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "Connexion réussie ! Bienvenue, %(name)s."

#: app.py:2375
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "Vous vous êtes déconnecté avec succès."

#: app.py:2392
msgid "Tài khoản demo không được phép đổi mật khẩu!"
msgstr "Comptes de Démo pour le Jury"

#: app.py:2400
msgid "Vui lòng điền đầy đủ thông tin đổi mật khẩu!"
msgstr "Veuillez renseigner tous les champs obligatoires (*)."

#: app.py:2404 app.py:2575
msgid "Mật khẩu mới và xác nhận mật khẩu không khớp!"
msgstr ""
"Le nouveau mot de passe et la confirmation du mot de passe ne "
"correspondent pas !"

#: app.py:2408 app.py:2579
msgid "Mật khẩu mới phải có tối thiểu 6 ký tự!"
msgstr "Le mot de passe doit comporter au moins 6 caractères."

#: app.py:2416
msgid "Mật khẩu hiện tại không chính xác!"
msgstr "Identifiant ou mot de passe incorrect !"

#: app.py:2422
msgid "Đổi mật khẩu thành công! Hãy ghi nhớ mật khẩu mới của bạn."
msgstr ""
"Mot de passe modifié avec succès ! N'oubliez pas votre nouveau mot de "
"passe."

#: app.py:2503
msgid "Vui lòng nhập địa chỉ email của bạn!"
msgstr "Veuillez entrer votre adresse e-mail !"

#: app.py:2516
msgid ""
"Không tìm thấy tài khoản quản trị hoặc giáo viên với email này. Vui lòng "
"liên hệ Tổng Quản trị viên (mshuyenuka@gmail.com) để được hỗ trợ."
msgstr ""
"Aucun compte administrateur ou enseignant trouvé avec cet e-mail. "
"Veuillez contacter l'administrateur général (mshuyenuka@gmail.com) pour "
"obtenir de l'aide."

#: app.py:2536
#, python-format
msgid ""
"Đã gửi liên kết đặt lại mật khẩu đến email %(email)s. Vui lòng kiểm tra "
"hộp thư (liên kết có hiệu lực trong 60 phút)."
msgstr ""
"Lien de réinitialisation du mot de passe envoyé à l'e-mail %(email)s. "
"Veuillez vérifier votre boîte de réception (le lien est valable 60 "
"minutes)."

#: app.py:2563
msgid ""
"Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn (chỉ dùng được 1 "
"lần trong 60 phút). Vui lòng gửi lại yêu cầu mới."
msgstr ""
"Le lien de réinitialisation du mot de passe n'est pas valide ou a expiré "
"(ne peut être utilisé qu'une fois toutes les 60 minutes). Veuillez "
"soumettre à nouveau une nouvelle demande."

#: app.py:2571
msgid "Vui lòng nhập đầy đủ mật khẩu mới và xác nhận mật khẩu!"
msgstr "Veuillez saisir le nouveau mot de passe et confirmer le mot de passe !"

#: app.py:2587
msgid "Đặt lại mật khẩu thành công! Bạn có thể đăng nhập bằng mật khẩu mới."
msgstr ""
"Réinitialisation du mot de passe réussie ! Vous pouvez vous connecter "
"avec votre nouveau mot de passe."

#: app.py:3118 app.py:3153
msgid "Chức năng chỉ dành riêng cho Tổng Quản trị viên (Super Admin)!"
msgstr "Fonction réservée au Super Admin uniquement !"

#: app.py:3165
msgid ""
"Vui lòng điền đầy đủ các thông tin bắt buộc (Mã đăng nhập, Họ tên, Trường"
" học, Mật khẩu)!"
msgstr "Veuillez renseigner tous les champs obligatoires (*)."

#: app.py:3169
msgid "Vai trò không hợp lệ (chỉ được tạo Quản trị trường hoặc Giáo viên)!"
msgstr ""
"Rôle invalide (seuls l'administrateur de l'école ou l'enseignant peuvent "
"être créés) !"

#: app.py:3175
msgid "ID trường học không hợp lệ!"
msgstr "Carte d'identité scolaire invalide !"

#: app.py:3182
#, python-format
msgid "Mã đăng nhập '%(ma)s' đã tồn tại trong hệ thống!"
msgstr "L'identifiant étudiant existe déjà dans le système. Veuillez vérifier !"

#: app.py:3195
#, python-format
msgid ""
"Đã tạo thành công tài khoản '%(ho_ten)s' (%(vai_tro)s) gắn với trường học"
" ID %(tid)s!"
msgstr ""
"Le compte « %(ho_ten)s » (%(vai_tro)s) associé à l'identifiant de l'école"
" %(tid)s a été créé avec succès !"

#: app.py:3210
msgid "Bạn không có quyền khôi phục dữ liệu Trường Demo!"
msgstr "Vous n'êtes pas autorisé à restaurer les données de Demo School !"

#: app.py:3215
msgid "Đã khôi phục toàn bộ dữ liệu Trường Demo về trạng thái ban đầu thành công!"
msgstr ""
"Toutes les données de Demo Field ont été restaurées avec succès à leur "
"état d'origine !"

#: app.py:3398
msgid "Quản trị trường chỉ có quyền nhập danh sách cho trường của mình!"
msgstr ""
"Les administrateurs scolaires ont uniquement le droit de saisir des "
"listes pour leurs écoles !"

#: app.py:3410
msgid "Vui lòng chọn file Excel (.xlsx) hoặc CSV (.csv) để nhập danh sách!"
msgstr ""
"Veuillez sélectionner le fichier Excel (.xlsx) ou CSV (.csv) pour "
"importer la liste !"

#: app.py:3422
#, python-format
msgid "Lỗi khi đọc file Excel: %(err)s"
msgstr "Erreur lors de la lecture du fichier Excel : %(err)s"

#: app.py:3435
msgid "Không thể giải mã file CSV. Vui lòng lưu file với định dạng UTF-8!"
msgstr ""
"Impossible de décoder le fichier CSV. Veuillez enregistrer le fichier au "
"format UTF-8 !"

#: app.py:3440
#, python-format
msgid "Lỗi khi đọc file CSV: %(err)s"
msgstr "Erreur lors de la lecture du fichier CSV : %(err)s"

#: app.py:3443
msgid "Định dạng file không được hỗ trợ. Vui lòng tải lên file .xlsx hoặc .csv!"
msgstr ""
"Format de fichier non pris en charge. Veuillez télécharger des fichiers "
".xlsx ou .csv !"

#: app.py:3447
msgid "File tải lên không có dữ liệu để nhập!"
msgstr "Le fichier téléchargé ne contient aucune donnée à importer !"

#: app.py:3470
msgid ""
"File thiếu cột bắt buộc 'họ_tên' hoặc 'vai_trò'. Vui lòng tải file mẫu để"
" kiểm tra đúng cấu trúc!"
msgstr ""
"Le fichier ne contient pas la colonne requise « nom_complet » ou « rôle "
"». Veuillez télécharger le fichier exemple pour vérifier la structure "
"correcte !"

#: app.py:3640
#, python-format
msgid ""
"Nhập danh sách thành công! Đã tạo %(count)s tài khoản cho trường "
"'%(school)s'. Vui lòng tải file Excel kết quả để phát thông tin đăng nhập"
" cho từng người."
msgstr ""
"Importez la liste avec succès ! Compte créé %(count)s pour le champ "
"'%(school)s'. Veuillez télécharger le fichier Excel résultant pour "
"distribuer les informations de connexion à chaque personne."

#: app.py:3642
#, python-format
msgid ""
"Đã tạo thành công %(sc)s tài khoản; %(ec)s dòng bị lỗi/bỏ qua. Xem bảng "
"tổng kết chi tiết bên dưới."
msgstr ""
"Compte %(sc)s créé avec succès ; Erreur/saut de ligne %(ec)s. Voir "
"tableau récapitulatif détaillé ci-dessous."

#: app.py:3644
#, python-format
msgid ""
"Không có tài khoản nào được tạo. Toàn bộ %(ec)s dòng trong danh sách đều "
"có lỗi."
msgstr ""
"Aucun compte n'a été créé. Toutes les lignes %(ec)s de la liste "
"comportent des erreurs."

#: app.py:3658
msgid ""
"Chưa có kết quả nhập tài khoản nào trong phiên làm việc hiện tại để tải "
"về!"
msgstr ""
"Il n'y a aucun résultat de saisie de compte à télécharger pour la session"
" en cours !"

#: app.py:3866
#, python-format
msgid "Đã sinh thành công %(count)s mã mời dạng TBEDU-XXXX-XXXX!"
msgstr "Code d'invitation %(count)s TBEDU-XXXX-XXXX généré avec succès !"

#: app.py:3882 app.py:3907 app.py:3976
msgid "Không tìm thấy người dùng."
msgstr "Utilisateur introuvable."

#: app.py:3886
msgid "Bạn chỉ có quyền phê duyệt học sinh thuộc trường của mình!"
msgstr ""
"Vous avez uniquement le droit d'approuver les étudiants appartenant à "
"votre école !"

#: app.py:3891
#, python-format
msgid "Đã phê duyệt tài khoản %(name)s (%(code)s) thành công!"
msgstr "Compte %(name)s (%(code)s) approuvé avec succès !"

#: app.py:3911
msgid "Bạn chỉ có quyền thao tác trên học sinh thuộc trường của mình!"
msgstr "Vous avez uniquement le droit d’opérer les élèves de votre école !"

#: app.py:3916
#, python-format
msgid "Đã từ chối đăng ký của học sinh %(name)s."
msgstr "L'inscription de l'étudiant %(name)s a été refusée."

#: app.py:3945
#, python-format
msgid "Đã phê duyệt %(count)s học sinh được chọn thành công!"
msgstr "Étudiants sélectionnés avec succès par %(count)s approuvé !"

#: app.py:3956
#, python-format
msgid "Đã duyệt toàn bộ %(count)s học sinh trong hàng chờ thành công!"
msgstr ""
"Tous les étudiants %(count)s dans la file d'attente ont été approuvés "
"avec succès !"

#: app.py:3980
msgid "Bạn chỉ có quyền khóa tài khoản thuộc trường của mình!"
msgstr "Vous avez uniquement le droit de bloquer le compte de votre école !"

#: app.py:3985
#, python-format
msgid ""
"Đã xác nhận KHÓA VĨNH VIỄN tài khoản của học sinh %(name)s (%(code)s) "
"theo quy chế xử lý vi phạm."
msgstr ""
"Confirmé pour VERROUILLER PERMANENTEMENT le compte étudiant %(name)s "
"(%(code)s) conformément à la réglementation sur le traitement des "
"violations."

#: app.py:4000
msgid "Đã xử lý / hủy đề xuất kỷ luật."
msgstr "Recommandation disciplinaire traitée/annulée."

#: app.py:4014
msgid ""
"Trường Demo (ID 99) là dữ liệu mẫu của hệ thống, không được phép chỉnh "
"sửa logo!"
msgstr ""
"Le champ de démonstration (ID 99) correspond à des exemples de données du"
" système, la modification du logo n'est pas autorisée !"

#: app.py:4018
msgid "Bạn không có quyền cập nhật logo cho trường này."
msgstr "Vous n'êtes pas autorisé à mettre à jour le logo de ce champ."

#: app.py:4034
msgid "Đã cập nhật logo trường thành công!"
msgstr "Le logo de l'école a été mis à jour avec succès !"

#: app.py:4036
msgid "Vui lòng chọn file ảnh hợp lệ (PNG, JPG, WEBP)."
msgstr "Veuillez sélectionner un fichier image valide (PNG, JPG, WEBP)."

#: app.py:4056 app.py:4142
msgid "Tên trường học không được để trống!"
msgstr "Le nom de l’école ne peut pas rester vide !"

#: app.py:4076
#, python-format
msgid "Trường học '%(name)s' đã tồn tại trong hệ thống!"
msgstr "L'identifiant étudiant existe déjà dans le système. Veuillez vérifier !"

#: app.py:4115
#, python-format
msgid "Đã thêm trường học mới '%(name)s' (Mã trường ID #%(id)s) thành công!"
msgstr "Nouvelle école '%(name)s' (ID d'école #%(id)s) ajoutée avec succès !"

#: app.py:4127
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép chỉnh sửa"
" hoặc xóa!"
msgstr ""
"Le champ Démo (ID 99) est un exemple de champ système, la modification ou"
" la suppression n'est pas autorisée !"

#: app.py:4135
msgid "Không tìm thấy trường học cần sửa!"
msgstr "Aucune école n’a besoin d’être réparée !"

#: app.py:4157
#, python-format
msgid "Tên trường '%(name)s' trùng với một trường học khác đã có!"
msgstr "Le nom du champ '%(name)s' correspond à une autre école existante !"

#: app.py:4179
#, python-format
msgid "Đã cập nhật thông tin trường '%(name)s' thành công!"
msgstr "Les informations du champ « %(name)s » ont été mises à jour avec succès !"

#: app.py:4193
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép vô hiệu "
"hóa!"
msgstr ""
"Le champ Démo (ID 99) est un exemple de champ système et ne peut pas être"
" désactivé !"

#: app.py:4201
msgid "Không tìm thấy trường học!"
msgstr "Système Multi-Établissements"

#: app.py:4242
msgid "Vui lòng nhập tên chương trình cộng đồng."
msgstr "Veuillez saisir le nom du programme communautaire."

#: app.py:4298 app.py:4368
msgid "Chương trình cộng đồng không tồn tại."
msgstr "Le programme communautaire n'existe pas."

#: app.py:4303
msgid "Bạn không có quyền chỉnh sửa chương trình của trường khác."
msgstr "Vous n'êtes pas autorisé à modifier le programme d'une autre école."

#: app.py:4314
msgid "Tên chương trình không được để trống."
msgstr "Le nom du programme ne peut pas être vide."

#: app.py:4373
msgid "Bạn không có quyền xóa chương trình của trường khác."
msgstr "Vous n'avez pas le droit de supprimer le programme d'une autre école."

#: app.py:4384 app.py:4389
msgid "tieu_de"
msgstr "tieu_de"

#: app.py:4569
msgid "Hành động không hợp lệ."
msgstr "Action invalide."

#: app.py:4578
#, python-format
msgid "Đã %(action)s kỹ năng #%(id)s thành công."
msgstr "Réussissez la compétence %(action)s #%(id)s."

#: app.py:4602
msgid "Kỹ năng không tồn tại!"
msgstr "Les compétences n'existent pas !"

#: app.py:4606
msgid "Bạn chỉ có thể đăng kỹ năng của chính mình lên Cộng đồng liên trường!"
msgstr ""
"Vous ne pouvez publier que vos propres compétences sur la communauté "
"interscolaire !"

#: app.py:4614
#, python-format
msgid "Bạn cần %(rem)s giờ dạy nữa để mở khóa Cộng đồng liên trường!"
msgstr ""
"Vous avez besoin de %(rem)s plus d'heures d'enseignement pour débloquer "
"la communauté interscolaire !"

#: app.py:4625
msgid ""
"Đã gửi yêu cầu đăng kỹ năng lên Cộng đồng liên trường. Vui lòng chờ Ban "
"quản trị duyệt!"
msgstr ""
"Soumis une demande pour publier la compétence sur la communauté "
"interscolaire. Veuillez attendre l'approbation du conseil "
"d'administration !"

#: app.py:4648 app.py:4679
msgid "Không tìm thấy kỹ năng!"
msgstr "Découvrir les Cours"

#: app.py:4664
#, python-format
msgid ""
"Đã duyệt kỹ năng '%(title)s' (%(school)s) lên Cộng đồng liên trường thành"
" công!"
msgstr ""
"La compétence « %(title)s » (%(school)s) a été approuvée avec succès par "
"la communauté interscolaire !"

#: app.py:4693
#, python-format
msgid "Đã từ chối đưa kỹ năng '%(title)s' lên Cộng đồng liên trường."
msgstr ""
"A refusé de soumettre la compétence « %(title)s » à la communauté "
"interscolaire."

#: app.py:4714
msgid "Vui lòng đăng nhập để truy cập Cộng đồng liên trường."
msgstr "Veuillez vous connecter pour continuer."

#: app.py:4926
msgid ""
"Tài khoản của bạn đang trong hàng chờ duyệt bởi Quản trị viên nhà trường."

msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "Veuillez vous connecter pour continuer."

#: app.py:338
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "Veuillez vous connecter avec un compte Administrateur."

#: app.py:353
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "Veuillez vous connecter avec un compte Super Administrateur."

#: app.py:369
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr ""
"Veuillez vous connecter avec les privilèges d'Enseignant ou "
"d'Administrateur."

#: app.py:2052
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "Veuillez renseigner tous les champs obligatoires (*)."

#: app.py:2056
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "Le mot de passe doit comporter au moins 6 caractères."

#: app.py:2060
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "La confirmation du mot de passe ne correspond pas."

#: app.py:2066
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "L'identifiant étudiant existe déjà dans le système. Veuillez vérifier !"

#: app.py:2083
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "Le code d'invitation n'existe pas. Veuillez vérifier !"

#: app.py:2086
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr ""
"L'école associée à ce code d'invitation est temporairement suspendue ou "
"désactivée !"

#: app.py:2089
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "Ce code d'invitation a atteint sa limite d'utilisation !"

#: app.py:2106
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "L'école sélectionnée est actuellement suspendue ou désactivée !"

#: app.py:2156
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr ""
"Félicitations ! Votre compte est activé avec un code d'invitation et 2,0 "
"crédits de temps vous sont accordés !"

#: app.py:2158
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr ""
"Inscription réussie ! Votre compte est en attente d'approbation par les "
"administrateurs scolaires."

#: app.py:2190
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "Identifiant ou mot de passe incorrect !"

#: app.py:2196
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr ""
"Votre compte a été verrouillé pour non-respect du règlement scolaire. "
"Veuillez contacter l'administration de l'école."

#: app.py:2216
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "Connexion réussie ! Bienvenue, %(name)s."

#: app.py:2236
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "Vous vous êtes déconnecté avec succès."


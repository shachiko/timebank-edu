msgid "MỨC ĐỘ 1"
msgstr "NIVEAU 1"

#: templates/noi_quy.html:144
msgid "Lần 1 — Nhắc nhở"
msgstr "1ère fois — Rappel"

#: templates/noi_quy.html:146

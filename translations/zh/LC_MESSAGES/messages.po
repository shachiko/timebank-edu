#: app.py:328
msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "请登录以继续访问。"

#: app.py:342
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "请使用管理员账户登录。"

#: app.py:357
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "请使用总管理员账户登录。"

#: app.py:373
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr "请使用教师或管理员权限登录。"

#: app.py:2191
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "请填写所有必填信息（*）。"

#: app.py:2195
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "密码长度必须至少为6个字符。"

#: app.py:2199
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "确认密码与输入的密码不一致。"

#: app.py:2205
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "学号已存在于系统中，请检查后重试！"

#: app.py:2222
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "邀请码不存在，请检查后重试！"

#: app.py:2225
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr "与该邀请码关联的学校当前已暂停或被禁用！"

#: app.py:2228
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "该邀请码已达到最大使用次数！"

#: app.py:2245
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "您选择的学校当前已暂停或被禁用！"

#: app.py:2295
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr "恭喜您！已通过邀请码成功激活账户，并获得2.0小时时间积分！"

#: app.py:2297
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr "注册成功！您的账户处于学校管理员“待审核”状态。在获得批准之前，您尚无法发布技能或预约课程。"

#: app.py:2329
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "登录账号或密码不正确！"

#: app.py:2335
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr "由于违反校规，您的账户已被锁定。请联系学校管理员以获取支持。"

#: app.py:2355
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "登录成功！欢迎您，%(name)s。"

#: app.py:2375
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "您已成功退出系统。"

#: app.py:2392
msgid "Tài khoản demo không được phép đổi mật khẩu!"
msgstr "评委专用演示账户"

#: app.py:2400
msgid "Vui lòng điền đầy đủ thông tin đổi mật khẩu!"
msgstr "请填写所有必填信息（*）。"

#: app.py:2404 app.py:2575
msgid "Mật khẩu mới và xác nhận mật khẩu không khớp!"
msgstr "新密码与确认密码不匹配！"

#: app.py:2408 app.py:2579
msgid "Mật khẩu mới phải có tối thiểu 6 ký tự!"
msgstr "密码长度必须至少为6个字符。"

#: app.py:2416
msgid "Mật khẩu hiện tại không chính xác!"
msgstr "登录账号或密码不正确！"

#: app.py:2422
msgid "Đổi mật khẩu thành công! Hãy ghi nhớ mật khẩu mới của bạn."
msgstr "密码修改成功！记住您的新密码。"

#: app.py:2503
msgid "Vui lòng nhập địa chỉ email của bạn!"
msgstr "请输入您的电子邮件地址！"

#: app.py:2516
msgid ""
"Không tìm thấy tài khoản quản trị hoặc giáo viên với email này. Vui lòng "
"liên hệ Tổng Quản trị viên (mshuyenuka@gmail.com) để được hỗ trợ."
msgstr "未找到此电子邮件的管理员或教师帐户。请联系总管理员 (mshuyenuka@gmail.com) 寻求支持。"

#: app.py:2536
#, python-format
msgid ""
"Đã gửi liên kết đặt lại mật khẩu đến email %(email)s. Vui lòng kiểm tra "
"hộp thư (liên kết có hiệu lực trong 60 phút)."
msgstr "密码重置链接已发送至 %(email)s 电子邮件。请检查您的收件箱（链接有效期为 60 分钟）。"

#: app.py:2563
msgid ""
"Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn (chỉ dùng được 1 "
"lần trong 60 phút). Vui lòng gửi lại yêu cầu mới."
msgstr "密码重置链接无效或已过期（每60分钟只能使用一次）。请重新提交新请求。"

#: app.py:2571
msgid "Vui lòng nhập đầy đủ mật khẩu mới và xác nhận mật khẩu!"
msgstr "请输入新密码并确认密码！"

#: app.py:2587
msgid "Đặt lại mật khẩu thành công! Bạn có thể đăng nhập bằng mật khẩu mới."
msgstr "密码重置成功！您可以使用新密码登录。"

#: app.py:3118 app.py:3153
msgid "Chức năng chỉ dành riêng cho Tổng Quản trị viên (Super Admin)!"
msgstr "仅限超级管理员使用的功能！"

#: app.py:3165
msgid ""
"Vui lòng điền đầy đủ các thông tin bắt buộc (Mã đăng nhập, Họ tên, Trường"
" học, Mật khẩu)!"
msgstr "请填写所有必填信息（*）。"

#: app.py:3169
msgid "Vai trò không hợp lệ (chỉ được tạo Quản trị trường hoặc Giáo viên)!"
msgstr "角色无效（只能创建学校管理员或教师）！"

#: app.py:3175
msgid "ID trường học không hợp lệ!"
msgstr "学校ID无效！"

#: app.py:3182
#, python-format
msgid "Mã đăng nhập '%(ma)s' đã tồn tại trong hệ thống!"
msgstr "学号已存在于系统中，请检查后重试！"

#: app.py:3195
#, python-format
msgid ""
"Đã tạo thành công tài khoản '%(ho_ten)s' (%(vai_tro)s) gắn với trường học"
" ID %(tid)s!"
msgstr "已成功创建与学校 ID %(tid)s 关联的帐户“%(ho_ten)s”(%(vai_tro)s)！"

#: app.py:3210
msgid "Bạn không có quyền khôi phục dữ liệu Trường Demo!"
msgstr "您无权恢复 Demo School 数据！"

#: app.py:3215
msgid "Đã khôi phục toàn bộ dữ liệu Trường Demo về trạng thái ban đầu thành công!"
msgstr "所有演示场数据已成功恢复至原始状态！"

#: app.py:3398
msgid "Quản trị trường chỉ có quyền nhập danh sách cho trường của mình!"
msgstr "中设置学校管理员只有权进入其学校的名单！"

#: app.py:3410
msgid "Vui lòng chọn file Excel (.xlsx) hoặc CSV (.csv) để nhập danh sách!"
msgstr "请选择Excel（.xlsx）或CSV（.csv）文件导入列表！"

#: app.py:3422
#, python-format
msgid "Lỗi khi đọc file Excel: %(err)s"
msgstr "读取 Excel 文件时出错：%(err)s"

#: app.py:3435
msgid "Không thể giải mã file CSV. Vui lòng lưu file với định dạng UTF-8!"
msgstr "无法解码 CSV 文件。请以UTF-8格式保存文件！"

#: app.py:3440
#, python-format
msgid "Lỗi khi đọc file CSV: %(err)s"
msgstr "读取 CSV 文件时出错：%(err)s"

#: app.py:3443
msgid "Định dạng file không được hỗ trợ. Vui lòng tải lên file .xlsx hoặc .csv!"
msgstr "不支持的文件格式。请上传.xlsx或.csv文件！"

#: app.py:3447
msgid "File tải lên không có dữ liệu để nhập!"
msgstr "上传的文件没有数据可导入！"

#: app.py:3470
msgid ""
"File thiếu cột bắt buộc 'họ_tên' hoặc 'vai_trò'. Vui lòng tải file mẫu để"
" kiểm tra đúng cấu trúc!"
msgstr "文件缺少所需的列“full_name”或“role”。请下载示例文件以检查结构是否正确！"

#: app.py:3640
#, python-format
msgid ""
"Nhập danh sách thành công! Đã tạo %(count)s tài khoản cho trường "
"'%(school)s'. Vui lòng tải file Excel kết quả để phát thông tin đăng nhập"
" cho từng người."
msgstr "导入列表成功！为字段“%(school)s”创建了帐户 %(count)s。请下载生成的 Excel 文件以将登录信息分发给每个人。"

#: app.py:3642
#, python-format
msgid ""
"Đã tạo thành công %(sc)s tài khoản; %(ec)s dòng bị lỗi/bỏ qua. Xem bảng "
"tổng kết chi tiết bên dưới."
msgstr "成功创建%(sc)s账户； %(ec)s 行错误/跳过。请参阅下面的详细汇总表。"

#: app.py:3644
#, python-format
msgid ""
"Không có tài khoản nào được tạo. Toàn bộ %(ec)s dòng trong danh sách đều "
"có lỗi."
msgstr "尚未创建任何帐户。列表中的所有 %(ec)s 行都有错误。"

#: app.py:3658
msgid ""
"Chưa có kết quả nhập tài khoản nào trong phiên làm việc hiện tại để tải "
"về!"
msgstr "当前会话没有帐户输入结果可供下载！"

#: app.py:3866
#, python-format
msgid "Đã sinh thành công %(count)s mã mời dạng TBEDU-XXXX-XXXX!"
msgstr "成功生成%(count)s邀请码TBEDU-XXXX-XXXX！"

#: app.py:3882 app.py:3907 app.py:3976
msgid "Không tìm thấy người dùng."
msgstr "未找到用户。"

#: app.py:3886
msgid "Bạn chỉ có quyền phê duyệt học sinh thuộc trường của mình!"
msgstr "您只有权批准属于您学校的学生！"

#: app.py:3891
#, python-format
msgid "Đã phê duyệt tài khoản %(name)s (%(code)s) thành công!"
msgstr "%(name)s（%(code)s）账户审核成功！"

#: app.py:3911
msgid "Bạn chỉ có quyền thao tác trên học sinh thuộc trường của mình!"
msgstr "你只有权利对你学校的学生进行手术！"

#: app.py:3916
#, python-format
msgid "Đã từ chối đăng ký của học sinh %(name)s."
msgstr "%(name)s 学生的注册已被拒绝。"

#: app.py:3945
#, python-format
msgid "Đã phê duyệt %(count)s học sinh được chọn thành công!"
msgstr "批准%(count)s成功选拔学生！"

#: app.py:3956
#, python-format
msgid "Đã duyệt toàn bộ %(count)s học sinh trong hàng chờ thành công!"
msgstr "队列中的所有 %(count)s 学生均已成功获得批准！"

#: app.py:3980
msgid "Bạn chỉ có quyền khóa tài khoản thuộc trường của mình!"
msgstr "您只有权利封锁您学校的账号！"

#: app.py:3985
#, python-format
msgid ""
"Đã xác nhận KHÓA VĨNH VIỄN tài khoản của học sinh %(name)s (%(code)s) "
"theo quy chế xử lý vi phạm."
msgstr "确认按照违规处理规定永久锁定学生%(name)s（%(code)s）账户。"

#: app.py:4000
msgid "Đã xử lý / hủy đề xuất kỷ luật."
msgstr "纪律建议已处理/取消。"

#: app.py:4014
msgid ""
"Trường Demo (ID 99) là dữ liệu mẫu của hệ thống, không được phép chỉnh "
"sửa logo!"
msgstr "演示字段（ID 99）为系统示例数据，不允许编辑徽标！"

#: app.py:4018
msgid "Bạn không có quyền cập nhật logo cho trường này."
msgstr "您无权更新该字段的徽标。"

#: app.py:4034
msgid "Đã cập nhật logo trường thành công!"
msgstr "校徽更新成功！"

#: app.py:4036
msgid "Vui lòng chọn file ảnh hợp lệ (PNG, JPG, WEBP)."
msgstr "请选择有效的图像文件（PNG、JPG、WEBP）。"

#: app.py:4056 app.py:4142
msgid "Tên trường học không được để trống!"
msgstr "学校名称不能为空！"

#: app.py:4076
#, python-format
msgid "Trường học '%(name)s' đã tồn tại trong hệ thống!"
msgstr "学号已存在于系统中，请检查后重试！"

#: app.py:4115
#, python-format
msgid "Đã thêm trường học mới '%(name)s' (Mã trường ID #%(id)s) thành công!"
msgstr "新学校“%(name)s”（学校 ID #%(id)s）添加成功！"

#: app.py:4127
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép chỉnh sửa"
" hoặc xóa!"
msgstr "演示字段（ID 99）为系统示例字段，不允许编辑或删除！"

#: app.py:4135
msgid "Không tìm thấy trường học cần sửa!"
msgstr "没有发现需要维修的学校！"

#: app.py:4157
#, python-format
msgid "Tên trường '%(name)s' trùng với một trường học khác đã có!"
msgstr "字段名称“%(name)s”与另一所现有学校匹配！"

#: app.py:4179
#, python-format
msgid "Đã cập nhật thông tin trường '%(name)s' thành công!"
msgstr "已成功更新“%(name)s”字段信息！"

#: app.py:4193
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép vô hiệu "
"hóa!"
msgstr "演示字段（ID 99）是系统示例字段，无法禁用！"

#: app.py:4201
msgid "Không tìm thấy trường học!"
msgstr "多校联合生态"

#: app.py:4242
msgid "Vui lòng nhập tên chương trình cộng đồng."
msgstr "请输入社区计划名称。"

#: app.py:4298 app.py:4368
msgid "Chương trình cộng đồng không tồn tại."
msgstr "社区计划不存在。"

#: app.py:4303
msgid "Bạn không có quyền chỉnh sửa chương trình của trường khác."
msgstr "您无权编辑其他学校的课程。"

#: app.py:4314
msgid "Tên chương trình không được để trống."
msgstr "程序名称不能为空。"

#: app.py:4373
msgid "Bạn không có quyền xóa chương trình của trường khác."
msgstr "您无权删除其他学校的项目。"

#: app.py:4384 app.py:4389
msgid "tieu_de"
msgstr "tieu_de"

#: app.py:4569
msgid "Hành động không hợp lệ."
msgstr "无效动作。"

#: app.py:4578
#, python-format
msgid "Đã %(action)s kỹ năng #%(id)s thành công."
msgstr "成功使用 %(action)s 技能#%(id)s。"

#: app.py:4602
msgid "Kỹ năng không tồn tại!"
msgstr "技能不存在！"

#: app.py:4606
msgid "Bạn chỉ có thể đăng kỹ năng của chính mình lên Cộng đồng liên trường!"
msgstr "您只能将自己的技能发布到校际社区！"

#: app.py:4614
#, python-format
msgid "Bạn cần %(rem)s giờ dạy nữa để mở khóa Cộng đồng liên trường!"
msgstr "您需要 %(rem)s 多教学时间才能解锁校际社区！"

#: app.py:4625
msgid ""
"Đã gửi yêu cầu đăng kỹ năng lên Cộng đồng liên trường. Vui lòng chờ Ban "
"quản trị duyệt!"
msgstr "已提交请求以将技能发布到校际社区。请等待管理委员会的批准！"

#: app.py:4648 app.py:4679
msgid "Không tìm thấy kỹ năng!"
msgstr "探索技能课堂"

#: app.py:4664
#, python-format
msgid ""
"Đã duyệt kỹ năng '%(title)s' (%(school)s) lên Cộng đồng liên trường thành"
" công!"
msgstr "技能“%(title)s”（%(school)s）已成功获得校际社区批准！"

#: app.py:4693
#, python-format
msgid "Đã từ chối đưa kỹ năng '%(title)s' lên Cộng đồng liên trường."
msgstr "拒绝向校际社区提交技能“%(title)s”。"

#: app.py:4714
msgid "Vui lòng đăng nhập để truy cập Cộng đồng liên trường."
msgstr "请登录以继续访问。"

#: app.py:4926
msgid ""
"Tài khoản của bạn đang trong hàng chờ duyệt bởi Quản trị viên nhà trường."
" Bạn chưa thể đăng kỹ năng cho đến khi tài khoản được kích hoạt."
msgstr "注册成功！您的账户处于学校管理员“待审核”状态。在获得批准之前，您尚无法发布技能或预约课程。"

#: app.py:4935
msgid "Vui lòng điền đầy đủ lĩnh vực, tiêu đề và mô tả kỹ năng."
msgstr "请填写字段、标题和技能描述。"

#: app.py:4939
msgid "Lĩnh vực đã chọn không hợp lệ."
msgstr "所选字段无效。"

#: app.py:4961
#, python-format
msgid ""
"Đăng ký thành công! %(reason)s. Kỹ năng đã sẵn sàng trên Kho kỹ năng học "
"đường."

#: app.py:328
msgid "Vui lòng đăng nhập để tiếp tục truy cập."
msgstr "Please log in to continue."

#: app.py:342
msgid "Vui lòng đăng nhập bằng tài khoản Quản trị viên."
msgstr "Please log in with an Administrator account."

#: app.py:357
msgid "Vui lòng đăng nhập bằng tài khoản Tổng quản trị."
msgstr "Please log in with a Super Administrator account."

#: app.py:373
msgid "Vui lòng đăng nhập với quyền Giáo viên hoặc Quản trị viên."
msgstr "Please log in with Teacher or Administrator privileges."

#: app.py:2191
msgid "Vui lòng điền đầy đủ các thông tin bắt buộc (*)."
msgstr "Please fill in all required fields (*)."

#: app.py:2195
msgid "Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên."
msgstr "Password must be at least 6 characters long."

#: app.py:2199
msgid "Mật khẩu xác nhận không khớp với mật khẩu đã nhập."
msgstr "Confirmation password does not match."

#: app.py:2205
msgid "Mã học sinh đã tồn tại trong hệ thống. Vui lòng kiểm tra lại!"
msgstr "Student ID already exists in the system. Please check again!"

#: app.py:2222
msgid "Mã mời không tồn tại trên hệ thống. Vui lòng kiểm tra lại!"
msgstr "Invitation code does not exist. Please check again!"

#: app.py:2225
msgid ""
"Trường học gắn với mã mời này hiện đang tạm dừng hoạt động hoặc đã bị ẩn "
"/ vô hiệu hóa!"
msgstr ""
"The school associated with this invite code is currently paused or "
"disabled!"

#: app.py:2228
msgid "Mã mời này đã hết số lượt sử dụng!"
msgstr "This invitation code has exceeded its maximum usage limit!"

#: app.py:2245
msgid ""
"Trường học bạn chọn hiện đang tạm dừng hoạt động hoặc đã bị ẩn / vô hiệu "
"hóa!"
msgstr "The selected school is currently paused or disabled!"

#: app.py:2295
msgid ""
"Chúc mừng bạn đã kích hoạt mở sổ thành công bằng mã mời và nhận ngay 2.0 "
"giờ tín dụng!"
msgstr ""
"Congratulations! Your account is activated with an invitation code and "
"2.0 time credits have been granted!"

#: app.py:2297
msgid ""
"Đăng ký thành công! Tài khoản của bạn đang ở trạng thái 'Chờ duyệt' bởi "
"Quản trị viên nhà trường. Bạn chưa thể đăng kỹ năng hoặc đặt lịch học cho"
" đến khi được duyệt."
msgstr ""
"Registration successful! Your account is pending approval by school "
"administrators. You cannot post skills or book sessions until approved."

#: app.py:2329
msgid "Mã đăng nhập hoặc mật khẩu không chính xác!"
msgstr "Incorrect login ID or password!"

#: app.py:2335
msgid ""
"Tài khoản của bạn đã bị khóa do vi phạm nội quy học đường. Vui lòng liên "
"hệ ban quản trị nhà trường để được hỗ trợ giải quyết."
msgstr ""
"Your account has been locked due to a school policy violation. Please "
"contact school administration."

#: app.py:2355
#, python-format
msgid "Đăng nhập thành công! Xin chào %(name)s."
msgstr "Login successful! Welcome, %(name)s."

#: app.py:2375
msgid "Bạn đã đăng xuất khỏi hệ thống thành công."
msgstr "You have been logged out successfully."

#: app.py:2392
msgid "Tài khoản demo không được phép đổi mật khẩu!"
msgstr "Demo Accounts for Judges"

#: app.py:2400
msgid "Vui lòng điền đầy đủ thông tin đổi mật khẩu!"
msgstr "Please fill in all required fields (*)."

#: app.py:2404 app.py:2575
msgid "Mật khẩu mới và xác nhận mật khẩu không khớp!"
msgstr "New password and confirm password do not match!"

#: app.py:2408 app.py:2579
msgid "Mật khẩu mới phải có tối thiểu 6 ký tự!"
msgstr "Password must be at least 6 characters long."

#: app.py:2416
msgid "Mật khẩu hiện tại không chính xác!"
msgstr "Incorrect login ID or password!"

#: app.py:2422
msgid "Đổi mật khẩu thành công! Hãy ghi nhớ mật khẩu mới của bạn."
msgstr "Password changed successfully! Remember your new password."

#: app.py:2503
msgid "Vui lòng nhập địa chỉ email của bạn!"
msgstr "Please enter your email address!"

#: app.py:2516
msgid ""
"Không tìm thấy tài khoản quản trị hoặc giáo viên với email này. Vui lòng "
"liên hệ Tổng Quản trị viên (mshuyenuka@gmail.com) để được hỗ trợ."
msgstr ""
"No admin or teacher account found with this email. Please contact the "
"General Administrator (mshuyenuka@gmail.com) for support."

#: app.py:2536
#, python-format
msgid ""
"Đã gửi liên kết đặt lại mật khẩu đến email %(email)s. Vui lòng kiểm tra "
"hộp thư (liên kết có hiệu lực trong 60 phút)."
msgstr ""
"Password reset link sent to %(email)s email. Please check your inbox "
"(link is valid for 60 minutes)."

#: app.py:2563
msgid ""
"Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn (chỉ dùng được 1 "
"lần trong 60 phút). Vui lòng gửi lại yêu cầu mới."
msgstr ""
"The password reset link is invalid or has expired (can only be used once "
"every 60 minutes). Please resubmit a new request."

#: app.py:2571
msgid "Vui lòng nhập đầy đủ mật khẩu mới và xác nhận mật khẩu!"
msgstr "Please enter the new password and confirm the password!"

#: app.py:2587
msgid "Đặt lại mật khẩu thành công! Bạn có thể đăng nhập bằng mật khẩu mới."
msgstr "Password reset successful! You can log in with your new password."

#: app.py:3118 app.py:3153
msgid "Chức năng chỉ dành riêng cho Tổng Quản trị viên (Super Admin)!"
msgstr "Function reserved for Super Admin only!"

#: app.py:3165
msgid ""
"Vui lòng điền đầy đủ các thông tin bắt buộc (Mã đăng nhập, Họ tên, Trường"
" học, Mật khẩu)!"
msgstr "Please fill in all required fields (*)."

#: app.py:3169
msgid "Vai trò không hợp lệ (chỉ được tạo Quản trị trường hoặc Giáo viên)!"
msgstr "Invalid role (only School Administrator or Teacher can be created)!"

#: app.py:3175
msgid "ID trường học không hợp lệ!"
msgstr "Invalid school ID!"

#: app.py:3182
#, python-format
msgid "Mã đăng nhập '%(ma)s' đã tồn tại trong hệ thống!"
msgstr "Student ID already exists in the system. Please check again!"

#: app.py:3195
#, python-format
msgid ""
"Đã tạo thành công tài khoản '%(ho_ten)s' (%(vai_tro)s) gắn với trường học"
" ID %(tid)s!"
msgstr ""
"Successfully created account '%(ho_ten)s' (%(vai_tro)s) associated with "
"school ID %(tid)s!"

#: app.py:3210
msgid "Bạn không có quyền khôi phục dữ liệu Trường Demo!"
msgstr "You do not have permission to restore Demo School data!"

#: app.py:3215
msgid "Đã khôi phục toàn bộ dữ liệu Trường Demo về trạng thái ban đầu thành công!"
msgstr "All Demo Field data has been restored to its original state successfully!"

#: app.py:3398
msgid "Quản trị trường chỉ có quyền nhập danh sách cho trường của mình!"
msgstr ""
"School administrators only have the right to enter lists for their "
"schools!"

#: app.py:3410
msgid "Vui lòng chọn file Excel (.xlsx) hoặc CSV (.csv) để nhập danh sách!"
msgstr "Please select Excel (.xlsx) or CSV (.csv) file to import the list!"

#: app.py:3422
#, python-format
msgid "Lỗi khi đọc file Excel: %(err)s"
msgstr "Error when reading Excel file: %(err)s"

#: app.py:3435
msgid "Không thể giải mã file CSV. Vui lòng lưu file với định dạng UTF-8!"
msgstr "Unable to decode CSV file. Please save the file in UTF-8 format!"

#: app.py:3440
#, python-format
msgid "Lỗi khi đọc file CSV: %(err)s"
msgstr "Error when reading CSV file: %(err)s"

#: app.py:3443
msgid "Định dạng file không được hỗ trợ. Vui lòng tải lên file .xlsx hoặc .csv!"
msgstr "File format not supported. Please upload .xlsx or .csv files!"

#: app.py:3447
msgid "File tải lên không có dữ liệu để nhập!"
msgstr "The uploaded file has no data to import!"

#: app.py:3470
msgid ""
"File thiếu cột bắt buộc 'họ_tên' hoặc 'vai_trò'. Vui lòng tải file mẫu để"
" kiểm tra đúng cấu trúc!"
msgstr ""
"The file is missing the required column 'full_name' or 'role'. Please "
"download the sample file to check the correct structure!"

#: app.py:3640
#, python-format
msgid ""
"Nhập danh sách thành công! Đã tạo %(count)s tài khoản cho trường "
"'%(school)s'. Vui lòng tải file Excel kết quả để phát thông tin đăng nhập"
" cho từng người."
msgstr ""
"Import list successfully! Created account %(count)s for field "
"'%(school)s'. Please download the resulting Excel file to distribute "
"login information to each person."

#: app.py:3642
#, python-format
msgid ""
"Đã tạo thành công %(sc)s tài khoản; %(ec)s dòng bị lỗi/bỏ qua. Xem bảng "
"tổng kết chi tiết bên dưới."
msgstr ""
"Successfully created %(sc)s account; %(ec)s line error/skip. See detailed"
" summary table below."

#: app.py:3644
#, python-format
msgid ""
"Không có tài khoản nào được tạo. Toàn bộ %(ec)s dòng trong danh sách đều "
"có lỗi."
msgstr "No accounts have been created. All %(ec)s lines in the list have errors."

#: app.py:3658
msgid ""
"Chưa có kết quả nhập tài khoản nào trong phiên làm việc hiện tại để tải "
"về!"
msgstr "There are no account entry results in the current session to download!"

#: app.py:3866
#, python-format
msgid "Đã sinh thành công %(count)s mã mời dạng TBEDU-XXXX-XXXX!"
msgstr "Successfully generated %(count)s invitation code TBEDU-XXXX-XXXX!"

#: app.py:3882 app.py:3907 app.py:3976
msgid "Không tìm thấy người dùng."
msgstr "User not found."

#: app.py:3886
msgid "Bạn chỉ có quyền phê duyệt học sinh thuộc trường của mình!"
msgstr "You only have the right to approve students belonging to your school!"

#: app.py:3891
#, python-format
msgid "Đã phê duyệt tài khoản %(name)s (%(code)s) thành công!"
msgstr "%(name)s (%(code)s) account approved successfully!"

#: app.py:3911
msgid "Bạn chỉ có quyền thao tác trên học sinh thuộc trường của mình!"
msgstr "You only have the right to operate on students in your school!"

#: app.py:3916
#, python-format
msgid "Đã từ chối đăng ký của học sinh %(name)s."
msgstr "%(name)s student's registration has been denied."

#: app.py:3945
#, python-format
msgid "Đã phê duyệt %(count)s học sinh được chọn thành công!"
msgstr "Approved %(count)s successfully selected students!"

#: app.py:3956
#, python-format
msgid "Đã duyệt toàn bộ %(count)s học sinh trong hàng chờ thành công!"
msgstr "All %(count)s students in the queue have been approved successfully!"

#: app.py:3980
msgid "Bạn chỉ có quyền khóa tài khoản thuộc trường của mình!"
msgstr "You only have the right to block your school's account!"

#: app.py:3985
#, python-format
msgid ""
"Đã xác nhận KHÓA VĨNH VIỄN tài khoản của học sinh %(name)s (%(code)s) "
"theo quy chế xử lý vi phạm."
msgstr ""
"Confirmed to PERMANENTLY LOCK student %(name)s (%(code)s) account "
"according to regulations on handling violations."

#: app.py:4000
msgid "Đã xử lý / hủy đề xuất kỷ luật."
msgstr "Disciplinary recommendation processed/cancelled."

#: app.py:4014
msgid ""
"Trường Demo (ID 99) là dữ liệu mẫu của hệ thống, không được phép chỉnh "
"sửa logo!"
msgstr "Demo field (ID 99) is system sample data, logo editing is not allowed!"

#: app.py:4018
msgid "Bạn không có quyền cập nhật logo cho trường này."
msgstr "You do not have permission to update the logo for this field."

#: app.py:4034
msgid "Đã cập nhật logo trường thành công!"
msgstr "School logo updated successfully!"

#: app.py:4036
msgid "Vui lòng chọn file ảnh hợp lệ (PNG, JPG, WEBP)."
msgstr "Please select a valid image file (PNG, JPG, WEBP)."

#: app.py:4056 app.py:4142
msgid "Tên trường học không được để trống!"
msgstr "School name cannot be left blank!"

#: app.py:4076
#, python-format
msgid "Trường học '%(name)s' đã tồn tại trong hệ thống!"
msgstr "Student ID already exists in the system. Please check again!"

#: app.py:4115
#, python-format
msgid "Đã thêm trường học mới '%(name)s' (Mã trường ID #%(id)s) thành công!"
msgstr "New school '%(name)s' (School ID #%(id)s) added successfully!"

#: app.py:4127
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép chỉnh sửa"
" hoặc xóa!"
msgstr ""
"Demo field (ID 99) is a system sample field, editing or deletion is not "
"allowed!"

#: app.py:4135
msgid "Không tìm thấy trường học cần sửa!"
msgstr "No schools found that need repair!"

#: app.py:4157
#, python-format
msgid "Tên trường '%(name)s' trùng với một trường học khác đã có!"
msgstr "The field name '%(name)s' matches another existing school!"

#: app.py:4179
#, python-format
msgid "Đã cập nhật thông tin trường '%(name)s' thành công!"
msgstr "Successfully updated '%(name)s' field information!"

#: app.py:4193
msgid ""
"Trường Demo (ID 99) là trường mẫu của hệ thống, không được phép vô hiệu "
"hóa!"
msgstr "The Demo field (ID 99) is a system sample field and cannot be disabled!"

#: app.py:4201
msgid "Không tìm thấy trường học!"
msgstr "Multi-School System"

#: app.py:4242
msgid "Vui lòng nhập tên chương trình cộng đồng."
msgstr "Please enter the community program name."

#: app.py:4298 app.py:4368
msgid "Chương trình cộng đồng không tồn tại."
msgstr "Community program does not exist."

#: app.py:4303
msgid "Bạn không có quyền chỉnh sửa chương trình của trường khác."
msgstr "You do not have permission to edit another school's program."

#: app.py:4314
msgid "Tên chương trình không được để trống."
msgstr "Program name cannot be empty."

#: app.py:4373
msgid "Bạn không có quyền xóa chương trình của trường khác."
msgstr "You do not have the right to delete another school's program."

#: app.py:4384 app.py:4389
msgid "tieu_de"
msgstr "tieu_de"

#: app.py:4569
msgid "Hành động không hợp lệ."
msgstr "Invalid action."

#: app.py:4578
#, python-format
msgid "Đã %(action)s kỹ năng #%(id)s thành công."
msgstr "Successfully %(action)s skill #%(id)s."

#: app.py:4602
msgid "Kỹ năng không tồn tại!"
msgstr "Skills do not exist!"

#: app.py:4606
msgid "Bạn chỉ có thể đăng kỹ năng của chính mình lên Cộng đồng liên trường!"
msgstr "You can only post your own skills to the Interschool Community!"

#: app.py:4614
#, python-format
msgid "Bạn cần %(rem)s giờ dạy nữa để mở khóa Cộng đồng liên trường!"
msgstr "You need %(rem)s more teaching hours to unlock the Interschool Community!"

#: app.py:4625
msgid ""
"Đã gửi yêu cầu đăng kỹ năng lên Cộng đồng liên trường. Vui lòng chờ Ban "
"quản trị duyệt!"
msgstr ""
"Submitted a request to post the skill to the Interschool Community. "
"Please wait for the Admin Board's approval!"

#: app.py:4648 app.py:4679
msgid "Không tìm thấy kỹ năng!"
msgstr "Explore Skills Classes"

#: app.py:4664
#, python-format
msgid ""
"Đã duyệt kỹ năng '%(title)s' (%(school)s) lên Cộng đồng liên trường thành"
" công!"
msgstr ""
"Skill '%(title)s' (%(school)s) has been successfully approved to the "
"Inter-School Community!"

#: app.py:4693
#, python-format
msgid "Đã từ chối đưa kỹ năng '%(title)s' lên Cộng đồng liên trường."
msgstr "Refused to submit skill '%(title)s' to the Interschool Community."

#: app.py:4714
msgid "Vui lòng đăng nhập để truy cập Cộng đồng liên trường."
msgstr "Please log in to continue."

#: app.py:4926
msgid ""
"Tài khoản của bạn đang trong hàng chờ duyệt bởi Quản trị viên nhà trường."
" Bạn chưa thể đăng kỹ năng cho đến khi tài khoản được kích hoạt."
msgstr ""
"Registration successful! Your account is pending approval by school "
"administrators. You cannot post skills or book sessions until approved."

#: app.py:4935
msgid "Vui lòng điền đầy đủ lĩnh vực, tiêu đề và mô tả kỹ năng."
msgstr "Please complete the field, title and skill description."

#: app.py:4939
msgid "Lĩnh vực đã chọn không hợp lệ."
msgstr "The selected field is invalid."

#: app.py:4961
#, python-format
msgid ""
"Đăng ký thành công! %(reason)s. Kỹ năng đã sẵn sàng trên Kho kỹ năng học "
"đường."
msgstr ""
"Registered successfully! %(reason)s. Skills are ready on the School "
"Skills Store."

#: app.py:4963
#, python-format
msgid ""
"Kỹ năng đang ở trạng thái 'Chờ duyệt' để Giáo viên thẩm định thêm. "
"%(reason)s"
msgstr ""
"The skill is in 'Waiting for approval' status for further evaluation by "
"the Teacher. %(reason)s"

#: app.py:4990
msgid "Kỹ năng này chưa sẵn sàng để đặt lịch học!"
msgstr "This skill is not yet ready to be scheduled!"

#: app.py:5017
msgid "Không tìm thấy thông tin tài khoản người học."
msgstr "No learner account information found."

#: app.py:5020
msgid ""
"Tài khoản của bạn đang trong hàng chờ duyệt bởi Quản trị viên nhà trường."
" Bạn chưa thể đặt lịch học cho đến khi tài khoản được kích hoạt."
msgstr ""
"Registration successful! Your account is pending approval by school "
"administrators. You cannot post skills or book sessions until approved."

#: app.py:5026
msgid "Kỹ năng không hợp lệ."
msgstr "Invalid skill."

#: app.py:5036
msgid "Vui lòng chọn thời gian hẹn học."
msgstr "Please select a study appointment time."

#: app.py:5041
msgid "Thời lượng mỗi buổi học tối đa là 2.0 giờ (và tối thiểu 0.5 giờ)!"
msgstr "Maximum duration of each lesson is 2.0 hours (and minimum 0.5 hours)!"

#: app.py:5048
msgid "Kỹ năng này chưa sẵn sàng hoặc chưa được phê duyệt sư phạm!"
msgstr "This skill is not yet ready or pedagogically approved!"

#: app.py:5053
msgid "Bạn không thể tự đặt lịch kỹ năng của chính mình!"
msgstr "You can't set your own skill schedule!"

#: app.py:5058
#, python-format
msgid ""
"Số dư tín dụng của bạn không đủ để đặt lịch buổi học này! (Hiện có: "
"%(cur).1fh, Cần: %(need).1fh). Hãy dạy kèm bạn bè để tích thêm giờ nhé!"
msgstr ""
"Your credit balance is insufficient to schedule this lesson! (Available: "
"%(cur).1fh, Needed: %(need).1fh). Tutor your friends to earn extra hours!"

#: app.py:5086
#, python-format
msgid ""

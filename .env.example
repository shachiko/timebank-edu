# Khóa bí mật Flask Session
FLASK_SECRET_KEY=thay-doi-khoa-nay-khi-deploy-2026

# Google Gemini API Key (Không điền trực tiếp vào repo)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình JaaS (8x8 Jitsi as a Service) cho phòng học ảo RS256 JWT
JAAS_APP_ID=vpaas-magic-cookie-sample
JAAS_API_KEY=vpaas-magic-cookie-sample/sample_api_key
JAAS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Cấu hình Daily.co (Nòng chính phòng học ảo)
DAILY_API_KEY=your_daily_api_key_here
VIDEO_PROVIDER=daily
